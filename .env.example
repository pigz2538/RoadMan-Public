APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./roadman.db
REDIS_URL=redis://localhost:6379/0
AMAP_WEBSERVICE_KEY=
LOAD_LOCAL_SKILL_CREDENTIALS=true
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:0731-cloud
# Optional Docker Desktop proxy. Use host.docker.internal instead of
# 127.0.0.1 so backend/worker containers can reach the host proxy.
ROADMAN_HTTP_PROXY=
ROADMAN_NO_PROXY=localhost,127.0.0.1,postgres,redis
ENABLE_LLM_REQUIREMENT_EXTRACTION=true
VITE_API_BASE_URL=http://localhost:8000
VITE_AMAP_JSAPI_KEY=
VITE_AMAP_SECURITY_JS_CODE=
# 生产环境推荐配置代理，配置后前端不再使用 securityJsCode：
VITE_AMAP_SERVICE_HOST=
