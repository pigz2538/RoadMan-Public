APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./roadman.db
REDIS_URL=redis://localhost:6379/0

# Docker Compose database defaults (override for deployment).
POSTGRES_DB=roadman
POSTGRES_USER=roadman
POSTGRES_PASSWORD=roadman_dev
CORS_ORIGINS=http://localhost:8080

# Provider credentials. Keep this file untracked and inject real values locally.
AMAP_WEBSERVICE_KEY=
OPENTRIPMAP_API_KEY=
FLYAI_API_KEY=
TRAIN_FALLBACK_URL=https://api.lolimi.cn/API/hc/api
# Optional mcp-server-12306 Streamable HTTP root or /mcp endpoint.
# The upstream repository is research-only; confirm licensing before commercial use.
MCP_12306_URL=
FLIGHT_FALLBACK_URL=https://open.6api.net/flight/getTicket
FLIGHT_FALLBACK_API_KEY=
AVIATIONSTACK_URL=https://api.aviationstack.com/v1/flights
AVIATIONSTACK_API_KEY=
OIL_API_URL=https://www.mxnzp.com/api/oil/search
OIL_APP_ID=
OIL_APP_SECRET=
# Provider-neutral semantic-agent configuration.  The request adapter sends
# an OpenAI-compatible Chat Completions body by default, so these values can
# point to Ollama Cloud, another OpenAI-compatible gateway, or a self-hosted
# endpoint without changing agent code.  LLM_API_URL is the complete endpoint.
LLM_PROVIDER=ollama_cloud
LLM_API_URL=https://ollama.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash:0731-cloud
LLM_API_STYLE=openai
LLM_THINKING=false
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_SECONDS=90

# Optional native Ollama compatibility (only use when LLM_API_STYLE is
# explicitly set to ollama_generate).
OLLAMA_API_URL=https://ollama.com/api/generate
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:0731-cloud

# Deprecated DeepSeek names. They are read only as migration aliases when the
# corresponding LLM_* value is empty. Prefer the canonical names above.
DEEPSEEK_API_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=0
DEEPSEEK_TIMEOUT_SECONDS=0
LOAD_LOCAL_SKILL_CREDENTIALS=true

# Optional Docker Desktop proxy. Use host.docker.internal instead of 127.0.0.1
# when backend/worker containers need to reach a host proxy.
ROADMAN_HTTP_PROXY=
ROADMAN_NO_PROXY=localhost,127.0.0.1,postgres,redis

ENABLE_LLM_REQUIREMENT_EXTRACTION=true
VITE_API_BASE_URL=http://localhost:8000
VITE_AMAP_JSAPI_KEY=
VITE_AMAP_SECURITY_JS_CODE=
# Optional same-origin proxy host for the AMap JS API loader.
VITE_AMAP_SERVICE_HOST=
