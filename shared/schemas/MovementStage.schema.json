{
  "$defs": {
    "Coordinates": {
      "properties": {
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        }
      },
      "required": [
        "longitude",
        "latitude"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "EnergyEstimate": {
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "unit": {
          "enum": [
            "kWh",
            "L"
          ],
          "title": "Unit",
          "type": "string"
        },
        "remaining_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Percent"
        },
        "estimated": {
          "default": true,
          "title": "Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "EnergyEstimate",
      "type": "object"
    },
    "MoneyRange": {
      "properties": {
        "currency": {
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "number"
        },
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "number"
        },
        "estimated": {
          "default": true,
          "title": "Estimated",
          "type": "boolean"
        },
        "source_count": {
          "default": 0,
          "minimum": 0,
          "title": "Source Count",
          "type": "integer"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "MoneyRange",
      "type": "object"
    },
    "PlaceRef": {
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "PlaceRef",
      "type": "object"
    },
    "PlanWarning": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "estimated": {
          "default": false,
          "title": "Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PlanWarning",
      "type": "object"
    },
    "RouteSegment": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "$ref": "#/$defs/Coordinates"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "distance_km": {
          "minimum": 0,
          "title": "Distance Km",
          "type": "number"
        },
        "duration_minutes": {
          "minimum": 0,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "road_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Road Name"
        },
        "toll": {
          "default": false,
          "title": "Toll",
          "type": "boolean"
        },
        "estimated": {
          "default": false,
          "title": "Estimated",
          "type": "boolean"
        },
        "elevation_gain_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Gain M"
        }
      },
      "required": [
        "coordinates",
        "distance_km",
        "duration_minutes"
      ],
      "title": "RouteSegment",
      "type": "object"
    },
    "SourceRecord": {
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "source_type": {
          "default": "unknown",
          "enum": [
            "official",
            "map",
            "ticketing",
            "travel_platform",
            "open_data",
            "web_search",
            "encyclopedia",
            "agent",
            "unknown"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "confidence": {
          "default": "unknown",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "facts": {
          "additionalProperties": true,
          "title": "Facts",
          "type": "object"
        }
      },
      "required": [
        "provider",
        "title"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "TransitLeg": {
      "properties": {
        "mode": {
          "default": "other",
          "enum": [
            "bus",
            "subway",
            "rail",
            "walk",
            "shuttle",
            "ferry",
            "other"
          ],
          "title": "Mode",
          "type": "string"
        },
        "line_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Name"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "line_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Type"
        },
        "departure_stop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Stop"
        },
        "arrival_stop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Stop"
        },
        "departure_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Time"
        },
        "arrival_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Time"
        },
        "stop_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Count"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "distance_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km"
        },
        "fare_cny": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fare Cny"
        }
      },
      "title": "TransitLeg",
      "type": "object"
    },
    "WeatherSample": {
      "properties": {
        "place": {
          "$ref": "#/$defs/PlaceRef"
        },
        "sampled_at": {
          "format": "date-time",
          "title": "Sampled At",
          "type": "string"
        },
        "temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "precipitation_probability": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precipitation Probability"
        },
        "weather_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weather Code"
        },
        "visibility_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visibility M"
        },
        "wind_speed_kmh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wind Speed Kmh"
        },
        "estimated": {
          "default": false,
          "title": "Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "place",
        "sampled_at"
      ],
      "title": "WeatherSample",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "day_id": {
      "title": "Day Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "mode": {
      "enum": [
        "driving",
        "transit",
        "walking",
        "riding",
        "taxi",
        "flight",
        "train",
        "ferry"
      ],
      "title": "Mode",
      "type": "string"
    },
    "transit_type": {
      "anyOf": [
        {
          "enum": [
            "bus",
            "subway",
            "shuttle",
            "ferry"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transit Type"
    },
    "transit_legs": {
      "items": {
        "$ref": "#/$defs/TransitLeg"
      },
      "title": "Transit Legs",
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/PlaceRef"
    },
    "destination": {
      "$ref": "#/$defs/PlaceRef"
    },
    "waypoints": {
