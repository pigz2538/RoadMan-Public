    "service_status": {
      "default": "unavailable",
      "enum": [
        "confirmed",
        "estimated",
        "unavailable"
      ],
      "title": "Service Status",
      "type": "string"
    },
    "transit_fare_cny": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transit Fare Cny"
    },
    "weather_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weather Summary"
    },
    "toll_fee": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "energy_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnergyEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
