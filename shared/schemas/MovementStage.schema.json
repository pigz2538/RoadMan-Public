      "title": "Planned Start",
      "type": "string"
    },
    "planned_end": {
      "format": "date-time",
      "title": "Planned End",
      "type": "string"
    },
    "distance_km": {
      "minimum": 0,
      "title": "Distance Km",
      "type": "number"
    },
    "duration_minutes": {
      "minimum": 0,
      "title": "Duration Minutes",
      "type": "integer"
    },
    "elevation_gain_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elevation Gain M"
    },
    "traffic_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traffic Summary"
    },
    "service_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Number"
    },
    "service_operator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Operator"
    },
    "departure_terminal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
