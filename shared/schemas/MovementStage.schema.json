    "weather_samples": {
      "items": {
        "$ref": "#/$defs/WeatherSample"
      },
      "title": "Weather Samples",
      "type": "array"
    },
    "risk_level": {
      "default": "low",
      "enum": [
        "low",
        "moderate",
        "high"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "risk_tags": {
      "items": {
        "type": "string"
      },
      "title": "Risk Tags",
      "type": "array"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "active",
        "completed",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/PlanWarning"
      },
      "title": "Warnings",
      "type": "array"
    },
    "source_records": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "title": "Source Records",
      "type": "array"
    }
  },
  "required": [
    "day_id",
    "sequence",
    "title",
    "mode",
    "origin",
    "destination",
    "planned_start",
    "planned_end",
    "distance_km",
    "duration_minutes"
  ],
  "title": "MovementStage",
  "type": "object"
}